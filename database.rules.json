{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[0-9]{6}$/)",
        ".write": "$code.matches(/^[0-9]{6}$/)",
        "host": {
          ".validate": "newData.hasChildren(['at'])",
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "state": {
          ".validate": "newData.hasChildren(['mode']) && newData.child('mode').isString()"
        },
        "players": {
          "$id": {
            ".validate": "$id.matches(/^[0-9a-f]{12}$/) && newData.hasChildren(['name', 'online'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "inputs": {
          "$id": {
            ".validate": "newData.hasChildren(['x', 'y', 'n'])",
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
            },
            "n": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "inbox": {
          "$id": {
            "$message": {
              ".validate": "newData.hasChildren(['kind']) && newData.child('kind').isString()"
            }
          }
        },
        "kicked": {
          "$id": {
            ".validate": "newData.isBoolean()"
          }
        },
        "events": {
          "$event": {
            ".validate": "newData.hasChildren(['id', 'type']) && (newData.child('type').val() === 'react' || newData.child('type').val() === 'answer' || newData.child('type').val() === 'ping')",
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "type": {
              ".validate": "newData.isString()"
            },
            "emoji": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "q": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "choice": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
