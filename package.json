{
  "name": "mountain-chicken",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:class": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "host": "npm run build && node server/index.mjs",
    "test": "npm run test:connection && npm run test:game",
    "test:connection": "node --test server/session.test.mjs",
    "test:game": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
